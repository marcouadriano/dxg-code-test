{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first nest start",
    "start:dev": "NODE_OPTIONS=--dns-result-order=ipv4first nest start --watch",
    "start:debug": "NODE_OPTIONS=--dns-result-order=ipv4first nest start --debug --watch",
    "start:prod": "node --dns-result-order=ipv4first dist/main",
    "start:audit-worker": "NODE_OPTIONS=--dns-result-order=ipv4first nest start --entryFile audit-worker/main",
    "start:audit-worker:prod": "node --dns-result-order=ipv4first dist/audit-worker/main",
    "seed:admin": "nest build && node dist/seed-admin.js",
    "lint": "oxlint --type-aware src/"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}

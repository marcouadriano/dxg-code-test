PORT=3000

# Logger settings. Optional; defaults shown.
APP_NAME=service
APP_LOGLEVEL=info

# Hours from UTC (e.g. 7, -5, 5.5) that decide which day a clock-in belongs to. Defaults to 0.
TIMEZONE_OFFSET=7

# Must point at a replica set (a single-node one is fine); transactions need it.
MONGODB_URI=mongodb://localhost:27017/dxg?replicaSet=rs0
# Optional; defaults shown.
# Milliseconds to wait for a reachable server before an operation fails.
DATABASE_CONN_TIMEOUT_MS=30000
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=0

# Separate database the audit worker logs profile changes into (`pnpm start:audit-worker`).
AUDIT_MONGODB_URI=mongodb://localhost:27017/dxg_audit?replicaSet=rs0

# Used by `pnpm seed:admin` to create the first HR admin.
# ADMIN_EMAIL=admin@company.com
# ADMIN_NAME=HR Admin
# ADMIN_PASSWORD=

REDIS_URL=redis://localhost:6379

# Directory for uploaded files, served at /uploads/.
UPLOAD_DIR=uploads

# ES256 key pair, PEM on one line with literal \n (see README "Auth keys").
JWT_KEY_ID=key-1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Optional; defaults shown. JWT_ALGORITHM must match the key pair type.
JWT_ALGORITHM=ES256
JWT_ISSUER=server/auth
JWT_ACCESS_AUDIENCE=server/*
JWT_REFRESH_AUDIENCE=server/auth
JWT_ACCESS_TTL_IN_SECONDS=900
JWT_REFRESH_TTL_IN_SECONDS=21600

# Failed sign-in / change-password attempts allowed per window. Optional; defaults shown.
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_IN_SECONDS=900

# Comma-separated frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# true when served over https.
COOKIE_SECURE=false
